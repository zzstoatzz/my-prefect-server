                },
                "decision": {
                  "type": "string",
                  "enum": [
                    "eligible",
                    "existing_pr",
                    "claimed",
                    "needs_info",
                    "contract_unclear",
                    "not_bug",
                    "closed",
                    "incomplete"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "issue_url": {
                  "type": "string"
                },
                "prior_art": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "mre": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              },
