        "orchestration": {
          "output_selection": "exactly_one",
          "evaluate_when": "all_reachable_terminal",
          "on_upstream": {
            "failed": "allow",
            "crashed": "allow",
            "cancelled": "allow",
            "timed_out": "allow"
          }
        },
        "objective": "Summarize only the supplied evidence; do not run commands. Deferred is an expected successful gate result, and absent fix result is expected when deferred exists. If eligible exists but fix result is absent, status=incomplete and explicitly report the missing fix result. Never call a deferred issue fixed. Copy real PR URL only if result.status=draft_pr or existing_pr and it is supplied. Preserve eligibility reasons and test limitations. If all inputs missing use issue_number=0, status=incomplete. Evidence should name checks and test outcomes without inventing them."
      }
    },
    "edges": [
      {
        "id": "issue_to_eligibility",
        "from": {
          "type": "plan_input",
          "input": "issue_number"
        },
        "to": {
          "node": "eligibility",
          "input": "issue_number"
        }
      },
      {
        "id": "eligible_to_fix",
        "from": {
          "type": "node_output",
          "node": "eligibility",
          "output": "eligible"
        },
        "to": {
          "node": "fix",
          "input": "candidate"
        }
