    "edges": [
      {
        "id": "issue_to_eligibility",
        "from": {
          "type": "plan_input",
          "input": "issue_number"
        },
        "to": {
          "node": "eligibility",
          "input": "issue_number"
        }
      },
      {
        "id": "eligible_to_fix",
        "from": {
          "type": "node_output",
          "node": "eligibility",
          "output": "eligible"
        },
        "to": {
          "node": "fix",
          "input": "candidate"
        }
      },
      {
        "id": "context_to_fix",
        "from": {
          "type": "plan_input",
          "input": "followup_context"
        },
        "to": {
          "node": "fix",
          "input": "followup_context"
        }
      },
      {
        "id": "patch_to_validation",
        "from": {
          "type": "node_output",
          "node": "fix",
          "output": "ready"
        },
        "to": {
          "node": "validate",
          "input": "parameters"
        }
      },
      {
        "id": "patch_to_publish",
        "from": {
          "type": "node_output",
          "node": "fix",
          "output": "ready"
        },
        "to": {
          "node": "review",
          "input": "patch"
        }
      },
      {
        "id": "candidate_to_publish",
        "from": {
          "type": "node_output",
          "node": "eligibility",
          "output": "eligible"
        },
        "to": {
          "node": "review",
          "input": "candidate"
        }
      },
      {
        "id": "validated_to_publish",
        "from": {
