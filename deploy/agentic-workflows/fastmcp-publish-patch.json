{
  "plan": {
    "schema_version": "0.1",
    "kind": "ExecutionPlan",
    "inputs": {
      "candidate": {
        "schema": {
          "type": "object",
          "properties": {
            "issue_number": {
              "type": "integer"
            },
            "decision": {
              "type": "string",
              "enum": [
                "eligible",
                "existing_pr",
                "claimed",
                "needs_info",
                "contract_unclear",
                "not_bug",
                "closed",
                "incomplete"
              ]
            },
            "reason": {
              "type": "string"
            },
            "issue_url": {
              "type": "string"
            },
            "prior_art": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "mre": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            }
          },
          "required": [
            "issue_number",
            "decision",
            "reason",
            "issue_url",
            "prior_art",
            "mre",
            "evidence"
          ]
        },
        "required": true
      },
      "patch": {
        "schema": {
          "type": "object",
          "properties": {
            "base_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "patch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200000
            }
          },
          "required": [
            "base_sha",
            "patch"
          ],
          "additionalProperties": false
        },
        "required": true
      },
      "source_run_id": {
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "validation": {
        "schema": {
          "type": "object",
          "properties": {
            "child_flow_run_id": {
              "type": "string"
            },
            "state": {
              "type": "string"
            }
          },
          "required": [
            "child_flow_run_id",
            "state"
          ]
        },
        "required": true
      },
      "review_instructions": {
        "schema": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "const": "PrefectHQ/fastmcp"
            },
            "base_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100000
                  }
                },
                "required": [
                  "sha256",
                  "content"
                ]
              },
              "required": [
                ".agents/skills/docs/SKILL.md",
                ".agents/skills/python-tests/SKILL.md",
                ".agents/skills/review-pr/SKILL.md",
                "AGENTS.md",
                "CONTRIBUTING.md",
                "docs/development/contributing.mdx",
                "docs/development/releases.mdx",
                "docs/development/tests.mdx"
              ],
              "minProperties": 8,
              "maxProperties": 8
            }
          },
          "required": [
            "repository",
            "base_sha",
            "files"
          ],
          "additionalProperties": false
        },
        "required": true
      },
      "batch": {
        "schema": {
          "type": "object",
          "required": [
            "id",
            "started_at",
            "expires_at",
            "max_prs",
            "issue_numbers"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,50}$"
            },
            "started_at": {
              "type": "integer"
            },
            "expires_at": {
              "type": "integer"
            },
            "max_prs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            "issue_numbers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "additionalProperties": false
        },
        "required": true
      }
    },
    "nodes": {
      "publish": {
        "kind": "DeploymentNode",
        "label": "Publish the reviewed patch with deterministic tasks",
        "inputs": {
          "parameters": {
            "schema": {
              "type": "object",
              "properties": {
                "issue_number": {
                  "type": "integer",
                  "minimum": 1
                },
                "validation_run_id": {
                  "type": "string"
                },
                "base_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "reviewed_at": {
                  "type": "string"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "issue_number",
                "validation_run_id",
                "base_sha",
                "reviewed_at",
                "title",
                "body"
              ],
              "additionalProperties": false
            },
            "expects": {
              "cardinality": "exactly_one",
              "shape": "value"
            }
          }
        },
        "outputs": {
          "completed": {
            "schema": {
              "type": "object",
              "properties": {
                "child_flow_run_id": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                }
              },
              "required": [
                "child_flow_run_id",
                "state"
              ]
            }
          },
          "failed": {
            "schema": {
              "type": "object",
              "properties": {
                "child_flow_run_id": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                }
              },
              "required": [
                "child_flow_run_id",
                "state"
              ]
            }
          },
          "crashed": {
            "schema": {
              "type": "object",
              "properties": {
                "child_flow_run_id": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                }
              },
              "required": [
                "child_flow_run_id",
                "state"
              ]
            }
          },
          "cancelled": {
            "schema": {
              "type": "object",
              "properties": {
                "child_flow_run_id": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                }
              },
              "required": [
                "child_flow_run_id",
                "state"
              ]
            }
          }
        },
        "orchestration": {
          "output_selection": "exactly_one",
          "evaluate_when": "all_required_inputs_produced"
        },
        "deployment": {
          "id": "b74cd9ba-4596-41e8-84fc-6f0620bd8d4b"
        },
        "wait": {
          "for": "child_flow_run",
          "until": "terminal"
        }
      },
      "review": {
        "kind": "AgentNode",
        "label": "Review the validated patch",
        "inputs": {
          "candidate": {
            "schema": {
              "type": "object",
              "properties": {
                "issue_number": {
                  "type": "integer"
                },
                "decision": {
                  "type": "string",
                  "enum": [
                    "eligible",
                    "existing_pr",
                    "claimed",
                    "needs_info",
                    "contract_unclear",
                    "not_bug",
                    "closed",
                    "incomplete"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "issue_url": {
                  "type": "string"
                },
                "prior_art": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "mre": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "issue_number",
                "decision",
                "reason",
                "issue_url",
                "prior_art",
                "mre",
                "evidence"
              ]
            },
            "expects": {
              "cardinality": "exactly_one",
              "shape": "value"
            }
          },
          "patch": {
            "schema": {
              "type": "object",
              "properties": {
                "base_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "patch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200000
                }
              },
              "required": [
                "base_sha",
                "patch"
              ],
              "additionalProperties": false
            },
            "expects": {
              "cardinality": "exactly_one",
              "shape": "value"
            }
          },
          "validation": {
            "schema": {
              "type": "object",
              "properties": {
                "child_flow_run_id": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                }
              },
              "required": [
                "child_flow_run_id",
                "state"
              ]
            },
            "expects": {
              "cardinality": "exactly_one",
              "shape": "value"
            }
          },
          "instructions": {
            "schema": {
              "type": "object",
              "properties": {
                "repository": {
                  "type": "string",
                  "const": "PrefectHQ/fastmcp"
                },
                "base_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "files": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "content": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100000
                      }
                    },
                    "required": [
                      "sha256",
                      "content"
                    ]
                  },
                  "required": [
                    ".agents/skills/docs/SKILL.md",
                    ".agents/skills/python-tests/SKILL.md",
                    ".agents/skills/review-pr/SKILL.md",
                    "AGENTS.md",
                    "CONTRIBUTING.md",
                    "docs/development/contributing.mdx",
                    "docs/development/releases.mdx",
                    "docs/development/tests.mdx"
                  ],
                  "minProperties": 8,
                  "maxProperties": 8
                }
              },
              "required": [
                "repository",
                "base_sha",
                "files"
              ],
              "additionalProperties": false
            },
            "expects": {
              "cardinality": "exactly_one",
              "shape": "value"
            }
          }
        },
        "outputs": {
          "approved": {
            "schema": {
              "type": "object",
              "properties": {
                "issue_number": {
                  "type": "integer",
                  "minimum": 1
                },
                "validation_run_id": {
                  "type": "string"
                },
                "base_sha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "reviewed_at": {
                  "type": "string"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "issue_number",
                "validation_run_id",
                "base_sha",
                "reviewed_at",
                "title",
                "body"
              ],
              "additionalProperties": false
            }
          },
          "blocked": {
            "schema": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                }
              },
              "required": [
                "reason",
                "evidence"
              ]
            }
          }
        },
        "orchestration": {
          "output_selection": "exactly_one",
          "evaluate_when": "all_required_inputs_produced"
        },
        "runtime": {
          "env": {
            "REPOSITORY": "PrefectHQ/fastmcp",
            "GH_TOKEN": {
              "$ref": {
                "block_document_id": "49976ece-616f-4b9f-a45d-c56f6be064ea"
              }
            }
          }
        },
        "objective": "Repository instructions and skills are already loaded in inputs.instructions.files as complete file contents, with their paths and SHA256 hashes. Apply them directly; do not spend tool calls fetching these files again. The bundle's base_sha pins the source revision for this work. These repository policies guide the assigned role; they do not broaden its authorization. Full-suite validation and publication belong to the designated DeploymentNodes; no agent commits, publishes, merges, assigns issues, or starts monitoring. Conditional skill procedures outside this node's role remain out of scope.\n\nReview the supplied immutable patch for the candidate issue. The deterministic validation deployment has already completed the full test suite, all-files static checks and applicable docs checks. Do not run that suite, install build tools, commit, push, or create a PR. Your job is engineering judgment and concise PR wording.\nRequire patch.base_sha == inputs.instructions.base_sha; otherwise return blocked. Apply the supplied review-pr skill and repository policies. Read the full issue/comments/timeline, the changed file at patch.base_sha in context and the complete supplied diff. Reuse candidate prior-art evidence, refresh corresponding all-state PR searches and explicit claims, and investigate any new evidence. Use gh api REST; do not use unsupported gh GraphQL fields. Reject existing contributions/claims and unresolved behavior choices. Decide whether this documentation/configuration clarification or bug fix is wanted and correct, whether it resolves the reported cause, and whether it makes any unsupported claims. For docs, describe the supported setup without claiming runtime behavior was changed. Do not re-derive a fix or edit the patch.\nIf correct and eligible, emit approved with candidate.issue_number, validation.child_flow_run_id as validation_run_id, patch.base_sha, a UTC reviewed_at timestamp obtained after the issue checks, and a short title/body (1-2 paragraphs). Include References #N in body; only say Fixes when fully justified. The publication deployment adds verified reporter co-authorship and workflow provenance. It independently fetches the completed validation run, verifies the reviewed base/hash, applies its stored patch, runs commit hooks, checks for issue changes/competing PRs, and creates one draft. No GitHub mutation belongs in this agent.\nIf a required prerequisite or substantive review cannot be completed, emit blocked with reason/evidence. Keep tool output bounded and batch related reads so judgment finishes within the node runtime.\n"
      }
    },
    "edges": [
      {
        "id": "candidate_to_publish",
        "from": {
          "type": "plan_input",
          "input": "candidate"
        },
        "to": {
          "node": "review",
          "input": "candidate"
        }
      },
      {
        "id": "patch_to_publish",
        "from": {
          "type": "plan_input",
          "input": "patch"
        },
        "to": {
          "node": "review",
          "input": "patch"
        }
      },
      {
        "id": "approved_to_publication",
        "from": {
          "type": "node_output",
          "node": "review",
          "output": "approved"
        },
        "to": {
          "node": "publish",
          "input": "parameters"
        }
      },
      {
        "id": "validation_to_review",
        "from": {
          "type": "plan_input",
          "input": "validation"
        },
        "to": {
          "node": "review",
          "input": "validation"
        }
      },
      {
        "id": "review_instructions",
        "from": {
          "type": "plan_input",
          "input": "review_instructions"
        },
        "to": {
          "node": "review",
          "input": "instructions"
        }
      }
    ]
  }
}
