[Unit]
Description=Stream subscriber turning gardener pull review comments into autofix.revise-requested events

[Service]
WorkingDirectory=%h
Environment=PREFECT_LOGGING_LEVEL=INFO
EnvironmentFile=%h/.config/prod-worker/env
StateDirectory=pull-comment-bridge
ExecStart=%h/.local/bin/uv run --no-project --with %h/phi-spike-worker/releases/9bc32712d3dfea7736344dcb98b443523a1eb8459c022483d611519f2a4c9133/mps-0.1.0-py3-none-any.whl python -m mps.pull_comment_bridge --state %S/pull-comment-bridge/cursor
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
MemoryMax=512M

[Install]
WantedBy=default.target
