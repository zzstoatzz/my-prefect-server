[Unit]
Description=Stream subscriber turning gardener pull review comments into autofix.revise-requested events

[Service]
WorkingDirectory=%h
Environment=PREFECT_LOGGING_LEVEL=INFO
EnvironmentFile=%h/.config/prod-worker/env
StateDirectory=pull-comment-bridge
ExecStart=%h/pull-comment-bridge/current/venv/bin/python -m mps.pull_comment_bridge --state %h/.local/state/pull-comment-bridge/cursor
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
MemoryMax=512M

[Install]
WantedBy=default.target
