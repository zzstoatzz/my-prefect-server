# Line-oriented config for /usr/local/bin/prefect-worker-guard.
# WORKER_COMMAND accepts either whitespace-separated argv or NUL-separated argv.
WORKER_COMMAND=/home/stoat/.local/bin/uv run --with prefect==3.7.2 prefect worker start --pool home-pool --type process --name heavypad --with-healthcheck
WORKER_NAME=heavypad
WORK_POOL_NAME=home-pool
SYSTEMD_UNIT=prefect-home-worker.service
CHECK_INTERVAL_SECONDS=30
GRACEFUL_SHUTDOWN_SECONDS=60
HEALTHCHECK_URL=http://127.0.0.1:8080/health
HEALTHCHECK_STARTUP_GRACE_SECONDS=120
HEALTHCHECK_UNHEALTHY_RETRIES=3
TERMINAL_DESCENDANT_CHECK_SECONDS=60
TERMINAL_DESCENDANT_TERMINATE_SECONDS=10
MEMORY_SOFT_BYTES=12884901888
MEMORY_HARD_BYTES=19327352832
TASKS_SOFT=500
TASKS_HARD=800
