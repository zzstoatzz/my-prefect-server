# Line-oriented config for /usr/local/bin/prefect-worker-guard.
# WORKER_COMMAND accepts either whitespace-separated argv or NUL-separated argv.
WORKER_COMMAND=/home/stoat/.local/bin/uv run --with prefect==3.7.2 prefect worker start --pool home-pool --type process --name heavypad
WORKER_NAME=heavypad
WORK_POOL_NAME=home-pool
SYSTEMD_UNIT=prefect-home-worker.service
CHECK_INTERVAL_SECONDS=30
GRACEFUL_SHUTDOWN_SECONDS=60
MEMORY_SOFT_BYTES=25769803776
MEMORY_HARD_BYTES=38654705664
TASKS_SOFT=1000
TASKS_HARD=1200
