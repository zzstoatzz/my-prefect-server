[Unit]
Description=Prefect worker on heavypad (prod home-pool, process)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=exec
User=stoat
Group=stoat
WorkingDirectory=/home/stoat
# prod API URL + auth string (PREFECT_API_URL, PREFECT_API_AUTH_STRING), 0600
EnvironmentFile=/home/stoat/.config/prod-worker/env
# uv must be on PATH: the process worker spawns `uv run ...` per flow run
Environment=PATH=/home/stoat/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=UV_CACHE_DIR=/home/stoat/.cache/uv
# prefect-worker-guard starts the pinned Prefect worker command from
# /etc/prefect-worker-guard.env and restarts its process group on local
# resource-threshold breaches.
ExecStart=/usr/local/bin/prefect-worker-guard --config /etc/prefect-worker-guard.env
KillMode=control-group
MemoryAccounting=yes
MemoryHigh=12G
MemoryMax=18G
MemorySwapMax=2G
TasksMax=800
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
