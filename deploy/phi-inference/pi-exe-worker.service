[Unit]
Description=Prefect worker for Gardener Pi workflows on exe.dev
After=network.target phi-inference.service

[Service]
WorkingDirectory=/home/stoat/gardener-exe-worker
Environment=PYTHONPATH=/home/stoat/gardener-exe-worker/src
Environment=PREFECT_LOGGING_LEVEL=INFO
Environment=EXE_IDENTITY_FILE=/home/stoat/.ssh/exe_gardener_ed25519
EnvironmentFile=/home/stoat/.config/prod-worker/env
ExecStart=/home/stoat/phi-spike-worker/venv/bin/python -m mps.exe_worker --pool gardener-exe --database /home/stoat/phi-inference/state/grants.sqlite --inference-url https://heavypad.tailb660b6.ts.net:8443/v1/chat/completions
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
MemoryMax=1G

[Install]
WantedBy=default.target
