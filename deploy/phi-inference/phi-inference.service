[Unit]
Description=Phi per-run inference access to Aperture
After=network.target

[Service]
WorkingDirectory=/home/stoat/phi-inference
Environment=PYTHONPATH=/home/stoat/phi-inference/src
EnvironmentFile=/home/stoat/.config/prod-worker/env
ExecStart=/usr/bin/python3 -m mps.inference_service --database /home/stoat/phi-inference/state/grants.sqlite --upstream http://100.99.202.12/v1/chat/completions --workflow-deployment 2c0ba8f3-7adf-44f8-a96e-8214c1bd8f2f --proposal-deployment ec0cc6dc-bed2-4b93-80ba-41c15cb2a5cb
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
MemoryMax=256M

[Install]
WantedBy=default.target
