{
  "uid": "executive-overview",
  "title": "executive overview",
  "tags": [
    "prefect",
    "executive"
  ],
  "timezone": "browser",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "heavypad / host",
      "type": "link",
      "url": "/d/heavypad-host",
      "icon": "external link",
      "tooltip": "the home box that runs every flow",
      "targetBlank": false
    },
    {
      "title": "github intelligence",
      "type": "link",
      "url": "/d/github-intelligence",
      "icon": "external link",
      "targetBlank": false
    },
    {
      "title": "prefect ui",
      "type": "link",
      "url": "https://prefect-server.waow.tech",
      "icon": "external link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "id": 1,
      "title": "flow runs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "late",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(prefect_flow_runs{state_name=\"Late\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "description": "scheduled runs whose expected start has passed and no worker has picked them up"
    },
    {
      "type": "stat",
      "id": 3,
      "title": "in flight",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(prefect_flow_runs{state_type=\"RUNNING\"}) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
