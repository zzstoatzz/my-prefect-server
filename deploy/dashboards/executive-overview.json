    {
      "type": "timeseries",
      "id": 18,
      "title": "server memory vs limit",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* limit"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"prefect\", container=~\"prefect-server.*\"})",
          "refId": "A",
          "legendFormat": "{{ pod }}"
        },
        {
          "expr": "max by (pod) (kube_pod_container_resource_limits{namespace=\"prefect\", resource=\"memory\", container=~\"prefect-server.*\"})",
          "refId": "B",
          "legendFormat": "{{ pod }} limit"
        }
      ],
      "description": "the services process was OOM-killed at its 256Mi limit on 2026-09-03; a line approaching its dashed limit is the warning"
    },
    {
      "type": "row",
      "collapsed": false,
      "id": 19,
      "title": "infrastructure",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
