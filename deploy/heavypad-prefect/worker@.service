[Unit]
Description=HeavyPad Prefect %i worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/prefect-home/worker.env
Environment=PATH=%h/.local/bin:%h/.local/share/prefect-home/bin:/usr/local/bin:/usr/bin:/bin
Environment=PREFECT_PLUGINS_ENABLED=false
ExecStart=%h/.local/share/prefect-home/bin/prefect worker start --pool heavypad-%i-pool --name heavypad-%i-worker --limit 1
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=120
MemoryHigh=6G
MemoryMax=8G
Nice=10
TasksMax=2048

[Install]
WantedBy=default.target
