[Unit]
Description=Copy encrypted HeavyPad Prefect backups to R2
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/prefect-dr/env
ExecStart=%h/.local/bin/prefect-dr --config %h/.config/prefect-dr/heavypad.toml offsite
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
