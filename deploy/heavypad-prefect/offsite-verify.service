[Unit]
Description=Restore the newest R2 Prefect backup into a throwaway PostgreSQL
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/prefect-dr/env
ExecStart=%h/.local/bin/prefect-dr --config %h/.config/prefect-dr/heavypad.toml verify
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min
