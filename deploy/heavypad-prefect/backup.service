[Unit]
Description=Encrypted backup of isolated HeavyPad Prefect
OnSuccess=prefect-home-offsite.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/prefect-dr/env
ExecStart=%h/.local/bin/prefect-dr --config %h/.config/prefect-dr/heavypad.toml backup
Nice=10
IOSchedulingClass=idle
MemoryMax=512M
CPUQuota=50%
