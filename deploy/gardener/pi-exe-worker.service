[Unit]
Description=Gardener exe.dev worker
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/stoat/gardener-exe-worker/current
Environment=PREFECT_LOGGING_LEVEL=INFO
Environment=EXE_IDENTITY_FILE=/home/stoat/.ssh/exe_gardener_ed25519
Environment=PHI_INFERENCE_MODEL=anthropic/claude-haiku-5.5
EnvironmentFile=/home/stoat/.config/prefect-home/client.env
Environment=GARDENER_TAILNET_CONFIG=/home/stoat/.config/prefect-home/gardener-tailnet.json
ExecStart=/home/stoat/gardener-exe-worker/current/venv/bin/python -m mps.exe_worker --pool gardener-exe --integration llm --inference-deployment 5f13c194-3287-4b81-974a-e1a538cc62f4 --inference-deployment 81b74ecf-4017-467d-b98e-078ad29ffc00 --observations /home/stoat/phi-inference/state/exe-observations.sqlite
Restart=on-failure
RestartSec=10
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
MemoryMax=1G

[Install]
WantedBy=default.target
