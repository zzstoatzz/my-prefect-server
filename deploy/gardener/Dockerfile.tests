ARG BASE_IMAGE=localhost:8000/gardener@sha256:d5b1526d6c97006804ba972fc6ab613654e3092d704b96be4291fb9ce140aad5
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION
LABEL io.waow.gardener.test-source=$SOURCE_REVISION
COPY test_pull_patch.py /opt/gardener/venv/lib/python3.13/site-packages/flows/test_pull_patch.py
RUN /opt/gardener/venv/bin/python -c 'import flows.test_pull_patch' \
    && /usr/local/bin/bun --version && /usr/local/bin/node --version
